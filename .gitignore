# ==========================================================
#  .gitignore — arquivos que NÃO entram no Git
#  ==========================================================
#  O Git guarda o histórico do projeto. Este arquivo diz:
#  "esses arquivos são temporários, gerados na sua máquina,
#   não precisa guardar no histórico".
#
#  Como verificar se algo está ignorado:
#    git check-ignore -v caminho/do/arquivo
# ==========================================================


# ---------- Build / Compilação ----------
# Pastas onde o Maven guarda o código compilado (.class) e o .jar final.
target/
build/
out/
bin/
*.class

# JARs gerados. O jar do Maven Wrapper é exceção: ele é baixado
# automaticamente e não deve ser versionado.
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Artefatos do Maven (relatórios de teste, listas de classes compiladas)
.mvn/timing.properties
.flattened-pom.xml
dependency-reduced-pom.xml

# Artefatos do Quarkus
quarkus-app/
.quarkus/
.mvn/wrapper/maven-wrapper.jar.lastUpdated


# ---------- Segredos e variáveis de ambiente ----------
# .env guarda senhas e credenciais reais: NUNCA entra no Git.
# O .env.example (só com valores de exemplo) continua versionado.
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.keystore
*.jks
secrets/
credentials.json


# ---------- Banco de dados local ----------
# Bancos de teste que o H2 cria na sua máquina.
*.db
*.mv.db
*.trace.db
*.h2.db
data/
postgres-data/


# ---------- Docker ----------
# Sobrescrita local do docker-compose.yml (ajustes pessoais de porta/credencial).
docker-compose.override.yml
.docker-compose.override.yml

# Contexto de build do Docker — o .dockerignore de cada projeto cuida disso.
.docker/
docker-data/


# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ---------- Editores de código / IDEs ----------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Eclipse
.settings/
.project
.classpath
.factorypath
*.launch
nbproject/private/
nbbuild/
dist/

# NetBeans
nbproject/
nbactions.xml


# ---------- Sistema operacional ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Vim / emacs
*.swp
*.swo
*~
.\#*


# ---------- Arquivos temporários do Java ----------
hs_err_pid*
replay_pid*
*.pid
*.orig
*.rej


# ---------- Sistema operacional / Cobertura ----------
coverage/
*.exec
jacoco.xml
*.lcov
