# Copie para .env e ajuste: cp .env.example .env
# (o .env esta no .gitignore)

# --- Postgres ---
POSTGRES_USER=contatos
POSTGRES_PASSWORD=contatos
POSTGRES_PORT=5432

# --- Portas publicadas no host ---
SPRING_BOOT_PORT=8080
QUARKUS_PORT=8081

# --- Comportamento das aplicacoes ---
# true  = insere 3 contatos de exemplo ao subir (util para smoke test)
# false = comeca com a tabela vazia
APP_SEED_ENABLED=true
